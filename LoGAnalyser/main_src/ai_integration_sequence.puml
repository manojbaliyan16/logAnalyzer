@startuml AI_Integration_Sequence

title AI-Enhanced Log Analysis Sequence Diagram

skinparam backgroundColor #FEFEFE
skinparam sequenceMessageAlign center

participant Main as "EM_Analyzer_main"
participant Analyzer as "Analyzer\n(Hybrid)"
participant PatternAnalyzer as "Pattern-Based\nAnalyzer"
participant AIAnalyzer as "AI_Analyzer"
participant Model as "ML Model"
participant Fusion as "Result Fusion"
participant Feedback as "Feedback\nCollector"
database JIRA as "JIRA"

== Log Analysis with AI Enhancement ==

Main -> Analyzer: analyzeLogs(logList)
activate Analyzer

loop For Each Log

    ' Pattern-based analysis
    Analyzer -> PatternAnalyzer: analyzeLog(log)
    activate PatternAnalyzer
    
    note right of PatternAnalyzer
    Traditional analysis:
    - Extract metadata
    - Match trace patterns
    - Check missing blocks
    - Generate Hansy link
    end note
    
    PatternAnalyzer --> Analyzer: pattern_result\n(Known patterns matched)
    deactivate PatternAnalyzer
    
    ' AI-based analysis
    alt AI Model Available
        Analyzer -> AIAnalyzer: analyze_log(log_content, metadata)
        activate AIAnalyzer
        
        AIAnalyzer -> AIAnalyzer: preprocess_log()
        note right
        - Clean log text
        - Tokenize with BERT
        - Extract metadata features
        end note
        
        AIAnalyzer -> Model: forward(input_ids, attention_mask, metadata)
        activate Model
        
        note right of Model
        Neural Network Inference:
        1. BERT encodes log text
        2. MLP encodes metadata
        3. Fusion layer combines
        4. Multi-task prediction:
           - Root cause
           - Severity
           - Components
        end note
        
        Model --> AIAnalyzer: raw_predictions\n(logits for each task)
        deactivate Model
        
        AIAnalyzer -> AIAnalyzer: postprocess_predictions()
        note right
        - Apply softmax
        - Get confidence scores
        - Format results
        - Find similar tickets
        - Generate recommendations
        end note
        
        AIAnalyzer --> Analyzer: ai_result\n{\n  root_cause: {label, confidence},\n  severity: {label, confidence},\n  components: [...],\n  similar_tickets: [...],\n  recommendations: [...]\n}
        deactivate AIAnalyzer
        
        ' Fusion of results
        Analyzer -> Fusion: combine_results(pattern_result, ai_result)
        activate Fusion
        
        note right of Fusion
        Intelligent Fusion Strategy:
        
        If AI confidence > 0.8:
          - Prioritize AI predictions
          - Use patterns as validation
        
        If AI confidence 0.5-0.8:
          - Balance both results
          - Highlight agreement/disagreement
        
        If AI confidence < 0.5:
          - Prioritize pattern-based
          - Mention AI uncertainty
        end note
        
        Fusion --> Analyzer: combined_result\n(Formatted JIRA comment)
        deactivate Fusion
        
    else AI Model Not Available
        note over Analyzer
        Fallback to
        pattern-based only
        end note
        Analyzer -> Analyzer: Use pattern_result only
    end
    
end

Analyzer --> Main: analysis_results\n(List of combined results)
deactivate Analyzer

' Update JIRA
Main -> JIRA: Post analysis comments
Main -> JIRA: Update labels & assign

' Feedback collection
Main -> Feedback: log_prediction(ticket_id, prediction, execution_time)
activate Feedback

note right of Feedback
Store for monitoring:
- Prediction details
- Confidence scores
- Execution time
- Timestamp
end note

Feedback -> Feedback: Store in metrics DB
deactivate Feedback

== Later: Analyst Review & Feedback ==

JIRA -> Feedback: Analyst resolves ticket\n(actual root cause, severity)
activate Feedback

Feedback -> Feedback: collect_analyst_feedback()
note right of Feedback
Compare:
- AI prediction vs actual
- Time saved
- Analyst confidence
- Correctness score
end note

Feedback -> Feedback: Store feedback for retraining
deactivate Feedback

== Periodic: Model Retraining ==

alt Retraining Triggered
    note over Feedback
    Trigger conditions:
    - 100+ new feedbacks
    - Accuracy drops < 85%
    - Scheduled monthly
    end note
    
    Feedback -> Model: retrain_model(new_labeled_data)
    activate Model
    
    Model -> Model: Train with updated data
    Model -> Model: Evaluate performance
    
    alt New Model Better
        Model -> Model: Deploy new version
        note right: Version: v2.1 → v2.2
    else New Model Worse
        Model -> Model: Keep current version
    end
    
    deactivate Model
end

@enduml
