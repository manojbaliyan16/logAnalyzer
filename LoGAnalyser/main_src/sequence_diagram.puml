@startuml LoGAnalyser_Sequence_Diagram

title LoGAnalyser - Automated Error Memory Log Analysis System\nComplete Workflow Sequence Diagram

skinparam backgroundColor #FEFEFE
skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true
skinparam BoxPadding 10
skinparam ParticipantPadding 20
skinparam SequenceGroupBorderColor #2196F3
skinparam SequenceGroupBackgroundColor #E3F2FD

actor User as "JIRA User"
participant Main as "EM_Analyzer_main\n<<Orchestrator>>"
participant Config as "configSettings\n<<Configuration>>"
participant DB as "DBInterfacing\n<<JIRA API>>"
participant Factory as "TicketFactory\n<<Factory>>"
participant Ticket as "Ticket\n<<Validator>>"
participant Logs as "Logs\n<<Processor>>"
participant Analyzer as "Analyzer\n<<Pattern Matcher>>"
participant Dashboard as "Dashboard_Updater\n<<Reporter>>"
database JIRA as "JIRA Server"
database Files as "File System"

== Phase 1: Configuration & Initialization ==

Main -> Config: 1. getFeatureControlConfig()
activate Config
Config -> Files: Read configs/feature_config.json
Config -> Config: Parse JSON
Config --> Main: Feature control config
deactivate Config

Main -> Config: 2. getValidationPatternConfig()
activate Config
Config -> Files: Read configs/Validation_Patterns_config.json
Config --> Main: Validation patterns
deactivate Config

Main -> Config: 3. getTracePatternConfig()
activate Config
Config -> Files: Read configs/Trace_Patterns_config.json
Config --> Main: Trace patterns
deactivate Config

Main -> Config: 4. getdownloadPipePatternConfig()
activate Config
Config -> Files: Read configs/downloadPipe_Patterns_config.json
Config --> Main: DownloadPipe patterns
deactivate Config

Main -> Config: 5. createGetLogsFolder()
Config -> Files: Create GetLogs/ directory if not exists

note over Main
Store all configs in
Global.global_var
end note

== Phase 2: JIRA Connection & Ticket Fetching ==

Main -> DB: 6. initializeDB(server, user, password)
activate DB
DB -> JIRA: Connect to JIRA server
activate JIRA
JIRA --> DB: JIRA connection object
DB --> Main: DB_reference
deactivate DB

Main -> DB: 7. generateDBQuery(ProjectName, Labels, Components)
activate DB
note right of DB
Generate JQL query:
"project = NCG3D AND 
labels in (EM_Analyzer_pending) AND 
component = SW_SWUPDATE"
end note
DB --> Main: JQL query string
deactivate DB

Main -> DB: 8. fetchDB(query, maxResults, downloadPath)
activate DB
DB -> JIRA: search_issues(query, maxResults)
JIRA --> DB: List of ticket references

loop For Each Ticket
    DB -> JIRA: Get ticket details\n(versions, relevance, brand, description, components)
    DB -> JIRA: Download attachments (.pro, .bin, .zip)
    JIRA --> Files: Save attachments
    DB -> Files: Create ticket folder\nGetLogs/NCG3D-XXXXXX/
end

DB -> DB: Frame FTMDT\n[TktNo, SW_ID, Relevance, Brand,\nAttachments, Description, FolderPath,\nReference, Components]
DB --> Main: FTMDT (List of Ticket Metadata)
deactivate DB
deactivate JIRA

Main -> Factory: 9. TicketFactory(FTMDT)
activate Factory
note right of Factory
Store FTMDT for
ticket-by-ticket processing
end note

== Phase 3: Ticket Processing Loop ==

group For Each Ticket [index = 0 to total_tickets-1]
    
    Main -> Factory: 10. pickTicket(index)
    Factory --> Main: FTMD (Single Ticket Metadata)
    
    Main -> Ticket: 11. Ticket(FTMD)
    activate Ticket
    
    Main -> Ticket: 12. ValidateTicketData()
    note right of Ticket
    Validation checks:
    1. Attachments present?
    2. Valid file types?
       (.pro, .bin, .zip, downloadPipe)
    3. Relevance field filled?
    4. Brand field filled?
    end note
    
    Ticket -> Ticket: Check attachments
    Ticket -> Ticket: Check relevance
    Ticket -> Ticket: Check brand
    
    Ticket --> Main: VTMD [Status, TktNo, Reasons/Data]
    
    alt Ticket is INVALID
        note over Main
        Mark as INVALID
        Set label: "EM_Analyzer_need_info"
        Add to INVTMDT
        Continue to next ticket
        end note
    else Ticket is VALID
        
        Main -> Ticket: 13. ManipulateTicketData(VTMD, folderPath)
        
        note right of Ticket
        Extract and enrich:
        - buildVersion (from SW_ID)
        - customerVersion (dashboard lookup)
        - platform (gen3/gen4 from Relevance)
        - variant (AIVI2, PIVI, etc.)
        - faultDate (parse from description)
        - TRC path (for decoding)
        end note
        
        Ticket -> Ticket: getBuildVersion(SW_ID)
        Ticket -> Ticket: getCustomerVersion(buildVersion)
        Ticket -> Ticket: getPlatform(Relevance)
        Ticket -> Ticket: getVariant(Relevance, Brand)
        Ticket -> Ticket: getFaultDate(Description)
        
        Ticket --> Main: MTMD [Status, TktNo, SW_ID, CustVer,\nBuildVer, Platform, Relevance, Variant,\nAttachments, FaultDate, TRCPath, Components]
        
        Main -> Logs: 14. Logs(MTMD, tkt_base_folder_path)
        activate Logs
        
        Main -> Logs: 15. getLogs()
        
        note right of Logs
        Process attachments:
        1. Categorize files (.pro, .bin, .zip)
        2. Extract zip files
        3. Validate .pro files
        4. Decode .bin files
        5. Rename & organize
        end note
        
        loop For Each Attachment
            
            alt Attachment is .zip
                Logs -> Files: Extract zip to Downloaded_ZIPS/
                Logs -> Logs: Recursively process contents
                Logs -> Logs: Rename with zip prefix
            end
            
            alt Attachment is .pro
                Logs -> Files: Open .pro file
                Logs -> Logs: validateDirectPro()\nCheck SW_ID match
                alt SW_ID Matches
                    Logs -> Logs: Rename: *_directPro.pro
                    Logs -> Files: Copy to DirectPro_LOGS/
                else SW_ID Mismatch
                    Logs -> Logs: Add to invalidPros
                end
            end
            
            alt Attachment is .bin AND TRCs available
                Logs -> Logs: changeExtension(.bin → .pro)
                Logs -> Files: Run decoder with TRC files
                Logs -> Logs: Validate decoded file
                Logs -> Logs: Rename: *_decoded_auto.pro
                Logs -> Files: Copy to Decoded_LOGS/
            else Attachment is .bin AND TRCs unavailable
                Logs -> Logs: Add to failed_to_decodeList
            end
            
        end
        
        Logs --> Main: logList\n[validLogList, invalidLogList, downloadPipeList]
        deactivate Logs
        
        Main -> Analyzer: 16. Analyzer(logList, faultDate,\nbuildVer, custVer, component)
        activate Analyzer
        
        Main -> Analyzer: 17. analyzeLogs()
        
        loop For Each Valid Log in logList[0]
            
            Analyzer -> Analyzer: analyzeLog(log)
            
            note right of Analyzer
            Comment Pattern Matching:
            - Extract log metadata
            - Get actual SW_ID from traces
            - Get log collection date
            - Get log availability dates
            - Check log status during fault date
            - Extract overwritten/missing blocks
            - Get serial number, part number
            - Generate Hansy visualization link
            end note
            
            Analyzer -> Files: Open log file
            Analyzer -> Analyzer: getMatchedCommentpatterns(log)
            Analyzer -> Analyzer: getLogname(log)
            Analyzer -> Analyzer: getSW_IDFromTraces(log)
            Analyzer -> Analyzer: getLogCollectedDate(log)
            Analyzer -> Analyzer: getLogAvailabilityfromtoDate(log)
            
            alt Fault Date Available
                Analyzer -> Analyzer: setLogAvstatusDuringFaultDate()
                
                alt Logs Missing/Overwritten
                    Analyzer -> Analyzer: getOverWrittenBlocks()
                    Analyzer -> Analyzer: getMissingBlocks()
                    Analyzer -> Analyzer: getSerialNo()
                    Analyzer -> Analyzer: getPartNo()
                    Analyzer -> Analyzer: getMissedLogInfo()
                end
            end
            
            Analyzer -> Analyzer: createHansyLink(log)
            
            note right of Analyzer
            Trace Pattern Matching:
            - Search for error signatures
            - Match configured patterns
            - Extract line numbers
            - Get occurrence dates
            - Recommend components
            end note
            
            alt Fault Date Available OR Component is SW_SWUPDATE
                Analyzer -> Analyzer: getMatchedTracePatternsList(log)
                
                loop For Each Trace Pattern in Config
                    Analyzer -> Files: Search pattern in log
                    alt Pattern Found
                        Analyzer -> Analyzer: Record line number, date, description
                    end
                end
            end
            
            Analyzer -> Analyzer: frameLogResult()\n- Combine comment parameters\n- Add trace matches\n- Format for JIRA
            
        end
        
        loop For Each Invalid Log in logList[1]
            Analyzer -> Analyzer: Generate error message\n"Inappropriate format / Invalid TRC"
        end
        
        loop For Each downloadPipe in logList[2]
            alt Component is SW_SWUPDATE
                Analyzer -> Analyzer: analyzeDownloadPipe()
                Analyzer -> Files: Parse downloadPipe file
                Analyzer -> Analyzer: Match update patterns
            end
        end
        
        Analyzer --> Main: analysis_results\n(List of formatted diagnostic comments)
        deactivate Analyzer
        
        note over Main
        Prepare PTMD:
        [TktNo, reference, label,
         logList, analysis_results,
         result_comment, assignee]
        Label: "EM_Analyzer_PreAnalyzed_auto"
        Status: SUCCESS
        end note
        
        Main -> Main: Increment SUCCEEEDED_TICKET_COUNT
        Main -> Main: Add PTMD to PTMDT
        
    end
    
    deactivate Ticket
    
end group

deactivate Factory

== Phase 4: JIRA Update ==

group For Each Processed Ticket in PTMDT
    
    activate JIRA
    
    loop For Each Log in analyzedLogList
        Main -> DB: add_comment(ticket_reference, analysis_comment)
        activate DB
        DB -> JIRA: POST comment to ticket
        deactivate DB
        
        alt Log is Decoded File (not direct .pro)
            Main -> DB: add_attachment(ticket_reference, decoded_log)
            activate DB
            DB -> JIRA: Upload decoded log file
            deactivate DB
        end
    end
    
    Main -> DB: Update ticket label
    activate DB
    note right of DB
    Change label from:
    "EM_Analyzer_pending"
    to:
    "EM_Analyzer_PreAnalyzed_auto"
    end note
    DB -> JIRA: update(fields={"labels": new_labels})
    deactivate DB
    
    Main -> DB: assign_issue(ticket, default_assignee)
    activate DB
    DB -> JIRA: Assign ticket to engineer
    deactivate DB
    
    deactivate JIRA
    
end group

== Phase 5: Dashboard & Metrics ==

Main -> Dashboard: 18. Dashboard_Updater(PTMDT, METRICS)
activate Dashboard

Main -> Dashboard: 19. updateDataDashboard()
Dashboard -> Files: Write Errmem_Dashboard.csv
note right of Dashboard
Columns:
- Ticket No
- Ticket Status (label)
- ARTA comment
- Assignee
end note

Main -> Dashboard: 20. updateMetricsDashboard()
Dashboard -> Files: Write Errmem_Metrics.csv
note right of Dashboard
Metrics:
- PROCESSED_TICKET_COUNT
- SUCCEEEDED_TICKET_COUNT
- FAILED_TICKET_COUNT
end note

deactivate Dashboard

== Phase 6: Error Logging ==

alt Error Logs Exist
    Main -> Main: BuildLogCreator(ERROR_LOGS)
    Main -> Files: Write Error_log.csv
    note right of Main
    Error columns:
    - Ticket number
    - Error traceback
    - Error type
    end note
end

note over Main
Processing Complete!
All tickets analyzed and updated.
end note

@enduml
