#----------------------------------------------------------------------#
# Definition of system ErrMem Types                                    #
#----------------------------------------------------------------------#

ARRAY ERRMEM_TYP = 0x0000 : Undef_
ARRAY ERRMEM_TYP = 0x0001 : Normal
ARRAY ERRMEM_TYP = 0x8000 : Info__
ARRAY ERRMEM_TYP = 0xFFFF : Fatal_

# ER_MEM_CLASS
11:(2)==0x1A:EM-Entry: 0x%04X(6,2,M) Trace Type: %u(ERRMEM_TYP,10,2,M) <%02u(12).%02u(13).%02u(14) %02u(15):%02u(16):%02u(17) UTC>:

# ER_MEM_ASSERT_EXCEP
11:(2)==0x1B:EM-Entry: 0x%04X(6,2,M) Trace Type: %u(ERRMEM_TYP,10,2,M) <%02u(12).%02u(13).%02u(14) %02u(15):%02u(16):%02u(17) UTC>:

# ER_MEM_NEW_LINE
11:(2)==0x1C:---------------------------------------------------------------------

# TR_DEFAULT_STRING_CLASS
# For the string traces, which do not have an own class code
11:(2)==0x1D:EM_String: %s(6,255)
# Outputs produced by error memory osal device
00:(2)==0xdf,(6)==255: %s(7,255)
00:(2)==0xdf,(6)==250:ERRMEM beginning of block %i(7,4)
00:(2)==0xdf,(6)==248:ERRMEM %i(7,4) blocks are missing

CMD EM_TRACE                           ::0f ff 02 7f 02 27
CMD EM_TRACE2                          ::0f ff 02 7f 02 30
CMD EM_ERASE                           ::0f ff 02 7f 02 28

