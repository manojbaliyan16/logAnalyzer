### import of '/var/jenkins/workspace/CI__Build_nav_int/generated/build/gen4lsim/elenabase/ahl_a_r/objects/ahl/ahl_trace.tro' ###
; Trace example file designed for copy & paste usage
; all comments with +++ action +++ designate places for changing this file
; don't delete them but just add your stuff

; General Message Structure for this trace messages
; Byte 0 = Length of message
; Byte 1 = TraceComponentNumber / also ClassNumber hi-byte
; Byte 2 = ClassNumber   
; Byte 3 = TRACE LEVEL as define above
; Byte 4 = Statistic (trace specific value)
; Byte 5 = Reserved (trace specific value)
; Byte 6 = FunctionName enum for Names of functions
; Byte 7 = FileNumber
; Byte 8 = LineNumber hi-Byte
; Byte 9 = LineNumber lo-Byte
; Byte 10= MessageType, defining generic message structures for the subsequent infos
; Byte 11= MessageCode, enum replacing the text of a specific message 
; Byte 12... Subsequent message structure is defined buy MessageType

; replace that number by your own component number and AHL by your own name
; care of multiple occurences!
; all following arrays are synchronised with ..._trace.h by 
; line copying of amended enum values.

; --------------------- Trace Component number definition --------------------- 
; moved to extra file to enable ADIT_GEN2 component ID corrections

; --------------------- array for files --------------------- 
; this array replaces file names by numbers in the trace stream 
ARRAY AHL_File = 0: ahl_tclBaseConfigStore.cpp
ARRAY AHL_File = 1: ahl_tclStreamConfigStore.cpp
ARRAY AHL_File = 2: ahl_NotificationTable.cpp 
ARRAY AHL_File = 3: ahl_Thread.cpp,\
   unknown\ file
; +++ TODO add your own filenames before "unknown file" and in ..._trace.h +++

; --------------------- array function names ----------------------
ARRAY AHL_FuncName = 0: FnConstructor
ARRAY AHL_FuncName = 1: FnDestructor
ARRAY AHL_FuncName = 2: FnGetApplicationVersion
ARRAY AHL_FuncName = 3: FnCreateDir 
ARRAY AHL_FuncName = 4: FnSetUserId
ARRAY AHL_FuncName = 5: FnLoadMachineData
ARRAY AHL_FuncName = 6: FnCreateConfigFile
ARRAY AHL_FuncName = 7: FnStoreMachineData
ARRAY AHL_FuncName = 8: FnLoadUserData
ARRAY AHL_FuncName = 9: FnStoreUserData
ARRAY AHL_FuncName =10: FnLoadData
ARRAY AHL_FuncName =11: FnStoreData  
ARRAY AHL_FuncName =12: FnRemoveMachineData       
ARRAY AHL_FuncName =13: FnRemoveUserData          
ARRAY AHL_FuncName =14: FnRemoveAllUserData
ARRAY AHL_FuncName =15: FnEnlargeFunctionArray
ARRAY AHL_FuncName =16: FnEnlargeNotificationArray
