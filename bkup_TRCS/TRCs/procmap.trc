########################################################################
# Entry point for OSG MapEngine                                        #
########################################################################
#63:(2)==0x00,>!mapcommon:MAP_ENGINE

#----------------------------------------------------------------------#
# Add TR_CLASS_MAPENGINE to the publicly known trace classes           #
#----------------------------------------------------------------------#
ARRAY TR_CLASS = 0x6340: TR_CLASS_MAPENGINE

ARRAY TR_CHAN = 0x63: TR_TTFIS_MAPENGINE

#----------------------------------------------------------------------
# General Syntax of cmds
# startbytes are always "0f ff 02" for sending a cmd to a channel
# 4th byte is channel No, in our case 0x63 for MapEngine channel
# 5th byte is byte count for CMD, including byte itself, so always "0x02"
# 6th Byte is command byte according to mapengine comand tokens

                                          # channel No is already hard coded, but this
                                          # is the way to replace it by a variable
#CMD MAPENGINE_MANUAL  ::0f ff 02 63 00

CMD MAPENGINE_CONFIG_CONTACT                                  :: 0f ff 02 63 01

#----------------------------------------------------------------------#
# Definition of commands                                               #
#----------------------------------------------------------------------#

CMD MAPENGINE_SEND_KEY             %u(KEY_CMD) %u() :: 0f ff 02 63 30 :%1(6,2,I), %2(10,4,I)
CMD MAPENGINE_SEND_KEYCODE         %u() %u() :: 0f ff 02 63 31 :%1(6,2,I), %2(10,4,I)
CMD MAPENGINE_SEND_USERCOMMAND     %u(USER_CMD) %u() :: 0f ff 02 63 32 :%1(6,2,I), %2(10,4,I)
CMD MAPENGINE_PRINT_STATS          %u() :: 0f ff 02 63 33 :%1(6,2,I)
CMD MAPENGINE_PRINT_USERSTATS      %u() :: 0f ff 02 63 34 :%1(6,2,I)
CMD MAPENGINE_SEND_USERCOMMAND_WITH_PARAM  %u(USER_CMD) %u() %u() :: 0f ff 02 63 35 :%1(6,2,I), %2(10,4,I), %3(14,10,I)
CMD MAPENGINE_SEND_USERCOMMAND_WITH_TWO_PARAMS  %u(USER_CMD) %u() %u() %u() :: 0f ff 02 63 36 :%1(6,2,I), %2(10,6,I), %3(14,10,I), %4(18,14,I)

