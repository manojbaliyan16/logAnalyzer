; ----------------------- coded message strings -----------------
; this list of messages is coded as one byte and translated into a string
; you can write the message including special charaters (space, tab and comma) 
; if a backslash is in front of it like 'Hello\ "Tom"\,\ "Jerry"\ and\ "Mike"'

ARRAY AHL_LEVEL = 0 : FATL
ARRAY AHL_LEVEL = 1 : ERRO 
ARRAY AHL_LEVEL = 2 : SMIN
ARRAY AHL_LEVEL = 3 : SYST
ARRAY AHL_LEVEL = 4 : COMP
ARRAY AHL_LEVEL = 5 : USR1
ARRAY AHL_LEVEL = 6 : USR2
ARRAY AHL_LEVEL = 7 : USR3
ARRAY AHL_LEVEL = 8 : USR4

; error message
ARRAY AHL_ErrString = 0: Unexpected\ case\ default\ reached
ARRAY AHL_ErrString = 1: Null\ pointer\ Can't\ reserve\ mem\ on\ heap
ARRAY AHL_ErrString = 2: Null\ pointer\ instance\ missing
ARRAY AHL_ErrString = 3: Value\ out\ of\ range
ARRAY AHL_ErrString = 4: No\ file\ name\ available
ARRAY AHL_ErrString = 5: Can't\ write\ into\ file
ARRAY AHL_ErrString = 6: Can't\ read\ from\ file
ARRAY AHL_ErrString = 7: No\ user\ id\ defined
ARRAY AHL_ErrString = 8: Maximum\ of\ allowed\ elements\ in\ array\ reached,\
   unknown\ err\ string
; +++ TODO add your own error strings before "unknown" and in ..._trace.h  +++

; warning message 
ARRAY AHL_WarnString  = 0: Unexpected\ case\ default\ reached
ARRAY AHL_WarnString  = 1: Wrong\ major\ version\ in\ file
ARRAY AHL_WarnString  = 2: No\ user\ ID\ set\ won't\ store\ configuration 
ARRAY AHL_WarnString  = 3: Thread\ stop\ did\ not\ work\ out,\
   unknown\ warn\ string
; +++ TODO add your own warning strings before "unknown" and in ..._trace.h  +++
   
; ----------------------- Bit field example definition -----------------
; Bit field replaces defined bits by given text concatinated by "|"
ARRAY AHL_BIT_FIELD_1     = 0x01         : BF_1_Value_1       
ARRAY AHL_BIT_FIELD_1     = 0x02         : BF_1_Value_2       
ARRAY AHL_BIT_FIELD_1     = 0x08         : BF_1_Value_4
ARRAY AHL_BIT_FIELD_1     = 0x04         : BF_1_Value_8 
ARRAY AHL_BIT_FIELD_1     = 0x10         : BF_1_Value_16       
ARRAY AHL_BIT_FIELD_1     = 0x20         : BF_1_Value_32       
ARRAY AHL_BIT_FIELD_1     = 0x40         : BF_1_Value_64 
ARRAY AHL_BIT_FIELD_1     = 0x80         : BF_1_Value_128 
; +++ TODO Copy bit field 1 and produce in same way your own bit fields
;     then put your interpretation in a new message later +++


; ----------------------- FlowControl Info -----------------
ARRAY AHL_FuncStep   = 0 : Entered
ARRAY AHL_FuncStep   = 1 : Step1
ARRAY AHL_FuncStep   = 2 : Step2
ARRAY AHL_FuncStep   = 3 : Step3
ARRAY AHL_FuncStep   = 4 : Leaving, unknown

; ----------------------- Place for new Arrays --------------------------
; +++ TODO add your own arrays here because they must be defined before usage +++


; ============================ Decoder ========================
; moved to extra file to differentiate the component ids

; next interpret class name 
; 1. Class detection Byte 2
; --------------------- Class decoding --------------------- 
!AHL_EVAL_CLASS:>!AHL_EVAL_MT:%u(AHL_Class,2) 

; 2. different message types defined by MsgType Byte 10
; --------------------- Message Types --------------------- 
; message type defines a prototype for trace messages. It allows easy copy and paste
; from messages with same parameter set.
; In case of test messages, which are intended to be commented out or deleted later
; you may prefer Code(0) Messages.
; Error Cases
!AHL_EVAL_MT:(10)==0,>!AHL_EVAL_ERROR:ERROR:
; Warning message 
!AHL_EVAL_MT:(10)==1,>!AHL_EVAL_WARN:WARN :
; General Info further coded by EVALS 
!AHL_EVAL_MT:(10)==2,>!AHL_EVAL_INFO:INFO :
; General Info Cases just with a string and function name; use for internal debugging only
!AHL_EVAL_MT:(10)==3,>!AHL_EVAL_FN:DEBUG: "%s(11,200)";
; General Info Cases just with a string, a number and function name; use for internal debugging only
!AHL_EVAL_MT:(10)==4,>!AHL_EVAL_FN:DEBUG: "%s(15,200)" %d(11,4,M);
; General Info Cases just with a list of strings one after each other with up to 255 chars in sum
!AHL_EVAL_MT:(10)==5,>!AHL_EVAL_FN:DEBUG: "%s(11,1,I,255,"")";

; +++ TODO add your own message types here and in tenMsgType +++
!AHL_EVAL_MT:>!AHL_EVAL_FN:%u(10) unknown message type; 
   
; 2.1 message code translation Byte 11ff
; --------------------- Error Messages in MessageCode --------------------- 
; all the following messages allow saving bandwith by defining tokens and arrays
; here in the trace file instead of passing everything with the string. 
; If you expect a message to be released with your code please prefer message coding 
; instead of wasting trac memory.
; just to tell the string and where the error occured
!AHL_EVAL_ERROR:(11)==0,>!AHL_EVAL_FN: %u(AHL_ErrString, 12);
; error with unspecified code and a string
!AHL_EVAL_ERROR:(11)==1,>!AHL_EVAL_FN: Code 0x%08x(12,4,M) "%s(16,200)";
; error with a value as hex and as decimal number
!AHL_EVAL_ERROR:(11)==2,>!AHL_EVAL_FN: Data 0x%08x(12,4,M) decimal %u(12,4,M);
; error as return value of an OSAL os function call
!AHL_EVAL_ERROR:(11)==3,>!AHL_EVAL_FN: OsalCode 0x%08x(12,4,M) "%s(16,200)";
; error because value became NULL
!AHL_EVAL_ERROR:(11)==4,>!AHL_EVAL_FN: %u(AHL_FuncName,6) Variable "%s(12,200)"is NULL;

; +++ TODO add your own message codes __before__ this line and in tenTrcErrorMsgCode +++
!AHL_EVAL_ERROR:>!AHL_EVAL_FN: unknown Error Message %u(11);

; --------------------- Warning Messages in MessageCode --------------------- 
; general warning with a __predefined__ string
!AHL_EVAL_WARN:(11)==0,>!AHL_EVAL_FN: %u(AHL_WarnString, 12); 
; Warning on NullPointer as return value you may combine this message with
;   error message 0 TRC::Error to throw an ASSERTION
!AHL_EVAL_WARN:(11)==1,>!AHL_EVAL_FN: NULL in "%s(12,200)"; 

; +++ TODO add your own warn messages __before__ this line and in tenTrcWarnMsgCode +++
!AHL_EVAL_WARN:>!AHL_EVAL_FN: unknown Warning Message %u(11);

; --------------------- Info Messages in MessageCode --------------------- 
; informs trace about entering or leaving functions for flow controlling
!AHL_EVAL_INFO:(11)==0,>!AHL_EVAL_FN: %u(AHL_FuncStep,12); 
; example message investigating a bit field
!AHL_EVAL_INFO:(11)==1,>!AHL_EVAL_FN: %x(AHL_BIT_FIELD_1,12,00000001:0,B+M,32," | ")
; info message for presenting positive steps reached with given s32 result
!AHL_EVAL_INFO:(11)==2,>!AHL_EVAL_FN: %u(AHL_FuncName,6) reached line %u(8,2,M) with result %u(12,4,M);

; +++ TODO add your own info messages __before__ this line and in tenTrcInfoMsgCode +++
!AHL_EVAL_INFO:>!AHL_EVAL_FN: unknown Info Message %u(11);

; 3. decode filename, class, function and line number Field 7-9
; --------------------- File Name and line Info --------------------- 
!AHL_EVAL_FN::\t[%u(AHL_File,7)|%u(AHL_Class,2)::%u(AHL_FuncName,6)(%u(8,2,M))]
;EOF


### import of '/var/jenkins/workspace/CI__Build_nav_int/generated/build/gen4lsim/elenabase/ahl_a_r/objects/ahl/ahl_trace_adit.tro' ###
; --------------------- Trace Component number definition --------------------- 
; Trace Comp ID here is TR_CLASS_AHL  = 0x8B10.
; this trace is restricted to 0x8B10 further down

; --------------------- array for classes --------------------- 
; this array replaces class names by numbers in the trace stream 
ARRAY TR_CLASS = 0x8B10:  TR_CLASS_AHL

; the following array is the low byte of the trace class which is reused 
; for string replacement same as the class really is named
; in case of framework we don't differentiate here
ARRAY AHL_Class  =  0x10:    LIB

; define buffers used later to evaluate trace message codes
ARRAY AHL_EVAL: AHL_EVAL_CLASS, AHL_EVAL_MT, AHL_EVAL_ERROR, \
                 AHL_EVAL_INFO, AHL_EVAL_WARN, AHL_EVAL_FILE

; ---------------------------- main entry ---------------------------- 
; trigger for trace component 
; print AHL if my comp and proceed with:
; 1. class detection 
; 2. Message decoding 
; 2.1 Message code translation
; 3. file and line information
; make sure we only look at AHL traces
8B:(1,2,M)==0x8B10,>!AHL_EVAL_CLASS:AHL_%u(AHL_LEVEL,3)_

