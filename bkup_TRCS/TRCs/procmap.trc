ARRAY ail_u8OpCodeErrorNumber = 0x0007 : CCA_C_U16_ERROR_VERSION_NOT_SUPPORTED   
ARRAY ail_u8OpCodeErrorNumber = 0x0008 : CCA_C_U16_ERROR_PARAMETER_MISSING       
ARRAY ail_u8OpCodeErrorNumber = 0x0009 : CCA_C_U16_ERROR_PARAMETER_TOO_MANY      
ARRAY ail_u8OpCodeErrorNumber = 0x000A : CCA_C_U16_ERROR_FUNCTION_BUSY           
ARRAY ail_u8OpCodeErrorNumber = 0x000B : CCA_C_U16_ERROR_TEMPORARY_NOT_AVAILABLE 
ARRAY ail_u8OpCodeErrorNumber = 0x000C : CCA_C_U16_ERROR_OPCODE_NOT_SUPPORTED    
ARRAY ail_u8OpCodeErrorNumber = 0x000D : CCA_C_U16_ERROR_INTERNAL_FAILURE        
ARRAY ail_u8OpCodeErrorNumber = 0x000E : CCA_C_U16_ERROR_UPREG_FAILURE           
ARRAY ail_u8OpCodeErrorNumber = 0x000F : CCA_C_U16_ERROR_RELUPREG_FAILURE        
ARRAY ail_u8OpCodeErrorNumber = 0x0010 : CCA_C_U16_ERROR_RELUPREG_CONF_WITHOUT_STATUS        

;---------------------------------------------------------------------------------------------------

; Types of state in ServiceSupplierStateMsg

ARRAY ail_u8ServiceSupplierState = 0x00       : UNAVAILABLE
ARRAY ail_u8ServiceSupplierState = 0x01       : AVAILABLE
ARRAY ail_u8ServiceSupplierState = 0x02       : UNKNOWN

; Types of state in u8AsyncRegisterConfStatus

ARRAY ail_u8AsyncRegisterConfStatus = 0x00    : SUCCESS                   
ARRAY ail_u8AsyncRegisterConfStatus = 0x01    : SERVER_DOES_NOT_RESPOND_TIMEOUT
ARRAY ail_u8AsyncRegisterConfStatus = 0x02    : SERVICE_VERSION_NOT_SUPPORTED
ARRAY ail_u8AsyncRegisterConfStatus = 0x03    : SERVICE_ALREADY_REGISTERED
ARRAY ail_u8AsyncRegisterConfStatus = 0x04    : SERVICE_DOES_NOT_EXIST    
ARRAY ail_u8AsyncRegisterConfStatus = 0x05    : SERVICE_ID_DOES_NOT_MATCH    
ARRAY ail_u8AsyncRegisterConfStatus = 0x06    : APPLICATION_ID_DOES_NOT_MATCH

;***************************************************************************************************

; string traces of AIL
8B:(2)==0x00,(6)==0x01: %2x(AIL_TR_CLASSNAME,1,2,M,1):{%2x(AIL_TR_LEVEL,3,1,I,1)}: %1s(7,1,I,250)

; string traces of SCD
8B:(2)==0x01: %2x(AIL_TR_CLASSNAME,1,2,M,1) {%2x(AIL_TR_LEVEL,3,1,I,1)}: %1s(6,1,I,250)

; string traces of AMT
8B:(2)==0x02: %2x(AIL_TR_CLASSNAME,1,2,M,1) {%2x(AIL_TR_LEVEL,3,1,I,1)}: %1s(6,1,I,250)

; string traces of ERR
60:(2)==0x02: %2x(AIL_TR_CLASSNAME,1,2,M,1) {%2x(AIL_TR_LEVEL,3,1,I,1)}: %1s(6,1,I,250)

; Data byte dump traces if AIL
8B:(2)==0x00,(6)==0x03: %2x(AIL_TR_CLASSNAME,1,2,M,1) {%2x(AIL_TR_LEVEL,3,1,I,1)}: Payload: (%03u(7,4,I)-%03u(11,4,I)):%02x(15,1,I,200," ")

; old string traces of AIL
8B:(2)==0x00,(6)>0x03: %2x(AIL_TR_CLASSNAME,1,2,M,1) {%2x(AIL_TR_LEVEL,3,1,I,1)}: %s(6,200)

;***************************************************************************************************

; Service recorder trace component values (high byte of trace class) with 0x83 and 0x84 are supported
; to get a value range of 0x8300 - 0x84FF (512 trace classes).

83:>!AIL_DECODE_SERVICE_MSG:
84:>!AIL_DECODE_SERVICE_MSG:

; Application recorder trace component values (high byte of trace class) with 0x85 and 0x86 are supported
; to get a value range of 0x8500 - 0x86FF (512 trace classes).

85:>!AIL_DECODE_APPLICATION_MSG:
86:>!AIL_DECODE_APPLICATION_MSG:

;===================================================================================================

; Service recorder trace types = STRING, MESSAGEDUMP, DATADUMP with byte 6 values of 0x01, 0x02 and 0x03

; String traces
!AIL_DECODE_SERVICE_MSG:(6)==0x01,>!AIL: %s(7,200)

; Data dump traces 
!AIL_DECODE_SERVICE_MSG:(6)==0x03: %2x(TR_CLASS,1,2,M,1) {%2x(AIL_TR_LEVEL,3,1,I,1)}: (%03u(7,4,I)-%03u(11,4,I)):%02x(15,1,I,200," ")

; Old string traces without string header
!AIL_DECODE_SERVICE_MSG:(6)>3: %2x(AIL_TR_CLASSNAME,1,2,M,1) {%2x(AIL_TR_LEVEL,3,1,I,1)}: %s(6,200)

;===================================================================================================

