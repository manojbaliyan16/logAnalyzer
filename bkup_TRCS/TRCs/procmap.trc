#----------------------------------------------------------------------#
# Add the publicly known trace classes         #
#----------------------------------------------------------------------#
ARRAY TR_CLASS = 0x1800: TR_COMP_OSALCORE
ARRAY TR_CLASS = 0x1801: TR_CLASS_OSAL_SYSCNTRL
ARRAY TR_CLASS = 0x1802: TR_CLASS_OSAL_SYSERROR
ARRAY TR_CLASS = 0x1803: TR_CLASS_OSAL_MEM
ARRAY TR_CLASS = 0x1804: TR_CLASS_OSAL_PERF
ARRAY TR_CLASS = 0x1805: TR_CLASS_OSAL_MEMPOOL
ARRAY TR_CLASS = 0x1806: TR_CLASS_OSAL_SEM
ARRAY TR_CLASS = 0x1807: TR_CLASS_OSAL_MTX
ARRAY TR_CLASS = 0x1808: TR_CLASS_OSAL_FLG

ARRAY TR_CHAN = 0x2c: TR_TTFIS_OSALCORE

ARRAY OSAL_FS_MAP = 0x00 : EN_NO_MAPPING
ARRAY OSAL_FS_MAP = 0x01 : EN_FFS_HOST


ARRAY OSAL_SIG_PATTERN = 0x00 : SigBlk
ARRAY OSAL_SIG_PATTERN = 0x01 : SigCgt
ARRAY OSAL_SIG_PATTERN = 0x02 : SigIgn


#----------------------------------------------------------------------#
# get info from system via OSAL                                        #
#----------------------------------------------------------------------#
ARRAY OSAL_RES = 0x0a:\
                 TASKS,\
                 EVENTS,\
                 SEMAPHORES,\
                 TIMER,\
                 MEMPOOLS,\
                 MESSAGE_QUEUES,\
                 MUTEXES,\
                 SHARED_MEM,\
                 FILES

CMD OSAL_LI_GET_RESOURCES %u(OSAL_RES)          ::0f ff 02 7e 02 12 :%1(7,1,M)
CMD OSAL_LI_GET_MQ_STATUS                       ::0f ff 02 7e 02 1f 
CMD OSAL_LI_GET_MQ_MAX_COUNT                    ::0f ff 02 7e 02 22
CMD OSAL_LI_GET_MSGQPOOL_INFO                   ::0f ff 02 7e 02 a3
CMD OSAL_LI_GET_RESOURCE_INFO                   ::0f ff 02 7e 02 6a
CMD OSAL_LI_GET_OSALPRC_INFO                    ::0f ff 02 7e 02 77

#----------------------------------------------------------------------#
# setting state in the system via OSAL                                 #
#----------------------------------------------------------------------#

########################################################################
# OSAL Assert Cmds and arrays                                          #
########################################################################

ARRAY ASSERT_MODE = 0x01 : SYSTEM_RESET
ARRAY ASSERT_MODE = 0x02 : SYSTEM_SUSPEND
ARRAY ASSERT_MODE = 0x03 : TASK_SUSPEND
ARRAY ASSERT_MODE = 0x04 : TASK_NOACTION

ARRAY LCOV_PROCESS_MODE = 0x00 : LCOV_RU
ARRAY LCOV_PROCESS_MODE = 0x01 : LCOV_SP1
ARRAY LCOV_PROCESS_MODE = 0x02 : LCOV_SP2
ARRAY LCOV_PROCESS_MODE = 0x03 : LCOV_SPIO
ARRAY ASSERT_TYPE = 0x01 : NORMAL
ARRAY ASSERT_TYPE = 0x00 : FATAL

ARRAY STRACE_TYPE = 0x00  : STRACE_OFF
ARRAY STRACE_TYPE = 0x01  : STRACE_FS_IO
ARRAY STRACE_TYPE = 0x02  : STRACE_NOFS_IO
ARRAY STRACE_TYPE = 0x04  : STRACE_PRC_TSK
ARRAY STRACE_TYPE = 0x08  : STRACE_TIMER
ARRAY STRACE_TYPE = 0x10  : STRACE_SH_MEM
ARRAY STRACE_TYPE = 0x20  : STRACE_MQ
ARRAY STRACE_TYPE = 0x40  : STRACE_SEM_MTX
ARRAY STRACE_TYPE = 0x80  : STRACE_EVENT
ARRAY STRACE_TYPE = 0x100 : STRACE_MSG
ARRAY STRACE_TYPE = 0x10000000 : STRACE_TRCDRV
ARRAY STRACE_TYPE = 0x20000000 : STRACE_REG
ARRAY STRACE_TYPE = 0xff  : STRACE_ALL

;  Message    Event ,    Sem/Mutex, MQ,        ShareMem,  Timer ,    Proc/Thread, No FS IO,    FS IO       Trace drv   Registry 
;  0x00000100 0x00000080 0x00000040 0x00000020  0x00000010 0x00000008 0x00000004   0x00000002  0x00000001  0x10000000  0x20000000

ARRAY OSAL_ONOFF = 0x00:\
                    OFF, \
                    ON

CMD OSAL_LI_MANUAL                              ::0f ff 02 7e 02 f0 
CMD OSAL_USB_RW_ACCESS                          ::0f ff 02 7e 02 88
CMD OSAL_LI_SET_ASSERT_MODE %u(ASSERT_MODE)     ::0f ff 02 7e 02 51 :%1(7,1,M)
CMD OSAL_LI_GET_ASSERT_MODE                     ::0f ff 02 7e 02 52
CMD OSAL_LI_TEST_ASSERT %i(ASSERT_TYPE)         ::0f ff 02 7e 02 53 :%1(7,1)

CMD OSAL_LI_GET_SIGNAL_MASK    %u(OSAL_SIG_PATTERN) %u(SIG)  ::0f ff 02 7e 02 79 :%1(7,1) %2(8,1)
CMD OSAL_LI_GET_CALLSTACKS_BY_NAME %s(PRC_NAME) ::0f ff 02 7e 02 80 :%1(7,200)
CMD OSAL_LI_GET_CALLSTACKS_BY_PID %u(PRC_ID)    ::0f ff 02 7e 02 81 :%1(8,4,M)

CMD OSAL_LI_SET_STRACE_PID  %u(PID) %u(STRACE_TYPE)::0f ff 02 7e 02 b3 :%1(7,4,M) %2(11,4,M)
CMD OSAL_LI_SET_TRACE_MQ    %u(OSAL_ONOFF) %s(MQ)  ::0f ff 02 7e 02 5f :%1(7,1) %2(8,32)
CMD OSAL_LI_SET_TRACE_SEM   %u(OSAL_ONOFF) %s(MQ)  ::0f ff 02 7e 02 a0 :%1(7,1) %2(8,32)
CMD OSAL_LI_SET_TRACE_EVENT %u(OSAL_ONOFF) %s(MQ)  ::0f ff 02 7e 02 a1 :%1(7,1) %2(8,32)
CMD OSAL_LI_SET_TRACE_SHMEM %u(OSAL_ONOFF) %s(MQ)  ::0f ff 02 7e 02 a4 :%1(7,1) %2(8,32)
CMD OSAL_LI_SET_TRACE_MTX   %u(OSAL_ONOFF) %s(MQ)  ::0f ff 02 7e 02 a6 :%1(7,1) %2(8,32)
CMD OSAL_LI_SET_TRACE_TIM   %u(OSAL_ONOFF) %u(TID) %u(TOUT) %u(INTERVAL)     ::0f ff 02 7e 02 a2 :%1(7,1,M) %2(8,4,M) %3(12,4,M) %3(16,4,M)
CMD OSAL_LI_SET_TRACE_TIM_PRC %u(OSAL_ONOFF) %u(PID)::0f ff 02 7e 02 a5 :%1(7,1,M) %2(8,4,M)
CMD OSAL_LI_MQ_SET_SV_CCA   %u(OSAL_ONOFF)         ::0f ff 02 7e 02 b0 :%1(7,1,M)
CMD OSAL_LI_MQ_SET_FILTER_CCA %u(OSAL_ONOFF) %u(SRC) %u(DST) %u(SERV) %u(FUNC) ::0f ff 02 7e 02 b1 :%1(7,1,M)  %2(8,2,M) %3(10,2,M) %4(12,2,M) %5(14,2,M)
CMD OSAL_LI_SET_SHELL_CMD   %s(CMD)                ::0f ff 02 7e 02 2a :%1(7,200)
CMD OSAL_LI_STACK_CHECK     %u(PID) %u(SLEEP)      ::0f ff 02 7e 02 6b :%1(7,4,M) %2(11,4,M)

CMD OSAL_LI_BLOCK_CPU   %u(AWAKE) %u(SLEEP) %u(PRI) %u(CPU) ::0f ff 02 7e 02 78 :%1(7,4,M) %2(11,4,M) %3(15,1,M) %4(16,1,M)


#----------------------------------------------------------------------#
# file system operation                                                #
#----------------------------------------------------------------------#
CMD OSAL_LI_FS_COPY_DIR %s(source)              ::0f ff 02 7e 02 14 :%1(7,200) 
CMD OSAL_LI_FS_MKDIR %s(dir)                    ::0f ff 02 7e 02 15 :%1(7,200) 
CMD OSAL_LI_FS_RM_DIR %s(dir)                   ::0f ff 02 7e 02 16 :%1(7,200) 
CMD OSAL_LI_FS_COPY_FILE %s(source)             ::0f ff 02 7e 02 17 :%1(7,200) 
CMD OSAL_LI_FS_RM_FILE %s(file)                 ::0f ff 02 7e 02 18 :%1(7,200) 
CMD OSAL_LI_FS_READ_DIR %s(file)                ::0f ff 02 7e 02 19 :%1(7,200) 
CMD OSAL_LI_FS_READ_FILE %s(file)               ::0f ff 02 7e 02 26 :%1(7,200) 
CMD OSAL_LI_FS_RM_FILESELECTION %s(file)        ::0f ff 02 7e 02 20 :%1(7,200) 
CMD OSAL_LI_FS_READ_DIR_SIZE %s(file)           ::0f ff 02 7e 02 11 :%1(7,200) 

#----------------------------------------------------------------------#
# various operations                                                   #
#----------------------------------------------------------------------#
CMD OSAL_LI_START_PROC %s(file)                 ::0f ff 02 7e 02 1a :%1(7,200) 
CMD OSAL_LI_FB_TEST                             ::0f ff 02 7e 02 21


