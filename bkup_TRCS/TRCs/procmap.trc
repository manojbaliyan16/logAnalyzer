#----------------------------------------------------------------------#
# Definitions of OSAL Core                                             #
#----------------------------------------------------------------------#
!osalcore:(6)==0x00, (7)==0x00:  %s(8,8): queue 100 percent full 
!osalcore:(6)==0x00, (7)==0x01:  %s(8,8): queue 90 percent full
!osalcore:(6)==0x00, (7)==0x02:  %s(8,8): queue 70 percent full
!osalcore:(6)==0x00, (7)==0x03:  %s(8,8): queue overflow


!osalcore:(6)==0x02:  %s(7,8): stack overflow
